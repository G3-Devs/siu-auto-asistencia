{
  "manifest_version": 3,
  "name": "Asistencia SIU + Form al Toque",
  "version": "4.5.6",
  "key": "",
  "description": "Formulario asistencia y marcado automático de asistencia",
  "permissions": ["identity", "storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://forms.googleapis.com/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "447770917718-fgljsubje8ng5ptqsar5uknd3kif884t.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/forms.body",
      "https://www.googleapis.com/auth/drive"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Abrir Asistencia",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles.css"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "asistencia-siu-altoque@unahur.edu.ar",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["styles.css", "content.js"],
      "matches": ["<all_urls>"]
    }
  ]
}